          "expr": "slo:sli_error:ratio_rate3d{sloth_service=\"shopsearch\",sloth_slo=\"$slo\"} / on(sloth_id) group_left slo:error_budget:ratio{sloth_service=\"shopsearch\",sloth_slo=\"$slo\"}",
          "legendFormat": "3d",
          "refId": "D",
          "range": true,
          "instant": false
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "x",
