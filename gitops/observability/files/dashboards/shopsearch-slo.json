      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "count(ALERTS{sloth_service=\"shopsearch\",sloth_slo=\"$slo\",alertstate=\"firing\"}) or vector(0)",
