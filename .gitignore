# tools downloaded by the Makefile
.bin/

# build output
node_modules/
dist/
target/
__pycache__/
*.pyc
.pytest_cache/
.venv/
venv/

# local secrets and editor files
.env
*.tfstate
*.tfstate.*
.terraform/
.idea/
.vscode/
*.iml
.DS_Store

# Terraform: modules are libraries, so their lock files are not pinned here
infra/modules/**/.terraform.lock.hcl
.terragrunt-cache/

# Helm dependencies are built from the charts next to them
gitops/charts/*/charts/
gitops/charts/*/Chart.lock
gitops/policies/tests/rendered.yaml
