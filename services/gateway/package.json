{
  "name": "gateway",
  "version": "0.1.0",
  "private": true,
  "description": "Public API for ShopSearch: routing, rate limiting, upstream error mapping.",
  "type": "module",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "start": "node dist/server.js",
    "lint": "tsc --noEmit -p tsconfig.json",
    "test": "vitest run"
  },
  "dependencies": {
    "@fastify/rate-limit": "^11.2.1",
    "@opentelemetry/api": "^1.10.0",
    "@opentelemetry/context-async-hooks": "^3.1.0",
    "@opentelemetry/core": "^3.1.0",
    "@opentelemetry/exporter-metrics-otlp-proto": "^0.301.0",
    "@opentelemetry/exporter-trace-otlp-proto": "^0.301.0",
    "@opentelemetry/instrumentation": "^0.301.0",
    "@opentelemetry/instrumentation-http": "^0.301.0",
    "@opentelemetry/instrumentation-undici": "^0.35.0",
    "@opentelemetry/resources": "^3.1.0",
    "@opentelemetry/sdk-metrics": "^3.1.0",
    "@opentelemetry/sdk-trace": "^3.1.0",
    "@opentelemetry/semantic-conventions": "^1.45.0",
    "fastify": "^5.12.7"
  },
  "devDependencies": {
    "@types/node": "^24.19.2",
    "typescript": "^7.0.2",
    "vitest": "^5.0.5"
