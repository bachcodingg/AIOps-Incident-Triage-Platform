          },
          "expr": "slo:sli_error:ratio_rate5m{sloth_service=\"shopsearch\",sloth_slo=\"$slo\"} / on(sloth_id) group_left slo:error_budget:ratio{sloth_service=\"shopsearch\",sloth_slo=\"$slo\"}",
